# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas URI works too: mongodb+srv://user:pass@cluster/...)
MONGO_URI=mongodb://127.0.0.1:27017/safestay

# Auth — use a long random string in production!
JWT_SECRET=change_this_to_a_long_random_string

# Rate limiting (registration/login protection)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=600000
